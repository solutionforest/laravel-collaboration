{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "allowJs": false
    },
    "include": [
        "resources/js/**/*.d.ts",
        "tests/types/**/*.ts",
        "tests/types/**/*.tsx"
    ]
}
