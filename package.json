{
    "name": "@solutionforest/laravel-collaboration",
    "version": "0.2.2",
    "private": true,
    "description": "The browser side of solutionforest/laravel-collaboration: a framework-free client, and adapters for Livewire, React, Vue and TipTap.",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": {
            "types": "./resources/js/index.d.ts",
            "default": "./resources/js/index.js"
        },
        "./comments": {
            "types": "./resources/js/comments.d.ts",
            "default": "./resources/js/comments.js"
        },
        "./history": {
            "types": "./resources/js/history.d.ts",
            "default": "./resources/js/history.js"
        },
        "./react": {
            "types": "./resources/js/react/index.d.ts",
            "default": "./resources/js/react/index.js"
        },
        "./react/editor": {
            "types": "./resources/js/react/editor.d.ts",
            "default": "./resources/js/react/editor.js"
        },
        "./react/comments": {
            "types": "./resources/js/react/comments.d.ts",
            "default": "./resources/js/react/comments.js"
        },
        "./react/history": {
            "types": "./resources/js/react/history.d.ts",
            "default": "./resources/js/react/history.js"
        },
        "./vue": {
            "types": "./resources/js/vue/index.d.ts",
            "default": "./resources/js/vue/index.js"
        },
        "./vue/editor": {
            "types": "./resources/js/vue/editor.d.ts",
            "default": "./resources/js/vue/editor.js"
        },
        "./vue/comments": {
            "types": "./resources/js/vue/comments.d.ts",
            "default": "./resources/js/vue/comments.js"
        },
        "./vue/history": {
            "types": "./resources/js/vue/history.d.ts",
            "default": "./resources/js/vue/history.js"
        },
        "./tiptap": {
            "types": "./resources/js/tiptap/index.d.ts",
            "default": "./resources/js/tiptap/index.js"
        },
        "./crdt/*": "./resources/js/crdt/*"
    },
    "files": [
        "resources/js",
        "resources/dist"
    ],
    "scripts": {
        "build": "vite build && vite build -c vite.editor.config.js && vite build -c vite.features.config.js",
        "lint": "eslint resources/js tests/js",
        "test": "node --test \"tests/js/*.test.js\"",
        "check": "npm run lint && npm run typecheck && npm test",
        "typecheck": "tsc -p tsconfig.json"
    },
    "peerDependencies": {
        "@inertiajs/react": "^3.0",
        "@inertiajs/vue3": "^3.0",
        "@tiptap/core": "^3.0",
        "@tiptap/pm": "^3.0",
        "@tiptap/react": "^3.0",
        "@tiptap/starter-kit": "^3.0",
        "@tiptap/vue-3": "^3.0",
        "react": "^19.0",
        "vue": "^3.5"
    },
    "peerDependenciesMeta": {
        "@inertiajs/react": {
            "optional": true
        },
        "@inertiajs/vue3": {
            "optional": true
        },
        "@tiptap/core": {
            "optional": true
        },
        "@tiptap/pm": {
            "optional": true
        },
        "@tiptap/react": {
            "optional": true
        },
        "@tiptap/starter-kit": {
            "optional": true
        },
        "@tiptap/vue-3": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/react": "^3.11.0",
        "@inertiajs/vue3": "^3.11.0",
        "@tiptap/core": "^3.35.0",
        "@tiptap/extension-image": "^3.35.0",
        "@tiptap/pm": "^3.35.0",
        "@tiptap/react": "^3.35.0",
        "@tiptap/starter-kit": "^3.35.0",
        "@tiptap/vue-3": "^3.35.0",
        "@types/react": "^19.3.2",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vue": "^3.5.46"
    },
    "sideEffects": [
        "./resources/js/livewire/*.js"
    ]
}
